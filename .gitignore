/target
# feel-parity is its own cargo project (outside the workspace), own target dir.
/feel-parity/target
# ...and so are the two Gate 0 projects (docs/dmn.md): the differential that
# links the C decimal library, and the wasm probe that carries the patch.
/feel-number-parity/target
/dmn-wasm-probe/target
**/*.rs.bk
.DS_Store
node_modules/
playground/dist/
playground/src/wasm/
playground/src/fixtures.generated.js
bpmnlint-plugin-rbpmn/wasm/
# The UI bundles are compile output like every other artifact here — minified,
# reproducible, edited by nobody. `just ui` builds them; rbpmn-ui's build.rs
# says so out loud if you forgot.
crates/rbpmn-ui/assets/
ui/dist/
ui/wasm/
ui/src/generated/
e2e/screenshots/
__pycache__/
# TLA+: fetched by `just tla`, plus TLC's scratch output.
/spec/.tla2tools-*.jar
/spec/states/
# Micro-benchmark baselines are per machine, by construction: the gate adds
# that machine's own measured noise to its threshold. Committing one would
# invite comparing against another machine's numbers, which is the single
# mistake the whole benchmark track exists to prevent. Everyone records their
# own with `just bench-baseline`.
/benchmarks/.baselines/
# Run output, for the same reason and one more: every file is stamped with the
# machine that produced it (`hardware.host_id`) and the commit it measured, so
# a committed result is one machine's numbers presented as the project's. They
# also churn on every run. Keep the ones you care about outside the repo, or
# publish them somewhere that records the hardware alongside.
/benchmarks/results/

# wasm-pack output for the Gate 0b probe — build artifacts, like every other
# wasm bundle here.
/dmn-wasm-probe/pkg

# Gate 0c fetches its inputs rather than vendoring them (docs/dmn.md): the
# DMN TCK corpus is separately OMG-licensed, and the dsntk source and test
# runner are pinned downloads. All of it is build input, none of it is ours.
/dmn-tck/tck
/dmn-tck/runner
/dmn-tck/patches
/dmn-tck/*.crate
/dmn-tck/*.csv
/dmn-tck/*.log
/dmn-tck/stock/dsntk-*
/dmn-tck/patched/dsntk-*
/dmn-tck/stock/target
/dmn-tck/patched/target
/dmn-tck/stock/Cargo.lock
