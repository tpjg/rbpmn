{
  "name": "rbpmn-playground",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Linter playground: visualize the fixture corpus with exactly the diagnostics deploy would produce (rbpmn-model compiled to WASM).",
  "scripts": {
    "gen": "node scripts/gen-fixtures.mjs",
    "predev": "npm run gen",
    "dev": "vite",
    "prebuild": "npm run gen",
    "build": "vite build",
    "preview": "vite preview",
    "parity": "npm run gen && node scripts/check-parity.mjs"
  },
  "dependencies": {
    "bpmn-auto-layout": "^1.3.0",
    "bpmn-js": "^18.22.1",
    "bpmn-moddle": "^10.1.0"
  },
  "devDependencies": {
    "vite": "^8.2.1"
  },
  "license": "(MIT OR Apache-2.0)"
}
