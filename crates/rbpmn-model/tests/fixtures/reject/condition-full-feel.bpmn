<?xml version="1.0" encoding="UTF-8"?>
<!-- expect-diagnostics:
  error conditions-feel-subset @ f_fn
  error conditions-feel-subset @ f_arith
  error conditions-feel-subset @ f_range
-->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  id="defs" targetNamespace="https://rbpmn.dev/fixtures">
  <!-- Valid FEEL, but outside the strict rbpmn subset: function calls,
       arithmetic and range tests are rejected at deploy. Compute the value in
       application code, store it as a variable, compare the flag. -->
  <bpmn:process id="p" isExecutable="true">
    <bpmn:startEvent id="start"/>
    <bpmn:exclusiveGateway id="xs" default="f_def"/>
    <bpmn:userTask id="ta" name="A"/>
    <bpmn:userTask id="tb" name="B"/>
    <bpmn:userTask id="tc" name="C"/>
    <bpmn:userTask id="td" name="D"/>
    <bpmn:endEvent id="e_a"/>
    <bpmn:endEvent id="e_b"/>
    <bpmn:endEvent id="e_c"/>
    <bpmn:endEvent id="e_d"/>
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="xs"/>
    <bpmn:sequenceFlow id="f_fn" sourceRef="xs" targetRef="ta">
      <bpmn:conditionExpression>sum(items) &gt; 3</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f_arith" sourceRef="xs" targetRef="tb">
      <bpmn:conditionExpression>amount + fee &gt; 100</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f_range" sourceRef="xs" targetRef="tc">
      <bpmn:conditionExpression>amount in [1..100]</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f_def" sourceRef="xs" targetRef="td"/>
    <bpmn:sequenceFlow id="f2" sourceRef="ta" targetRef="e_a"/>
    <bpmn:sequenceFlow id="f3" sourceRef="tb" targetRef="e_b"/>
    <bpmn:sequenceFlow id="f4" sourceRef="tc" targetRef="e_c"/>
    <bpmn:sequenceFlow id="f5" sourceRef="td" targetRef="e_d"/>
  </bpmn:process>
</bpmn:definitions>
