<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="defs" targetNamespace="https://rbpmn.dev/fixtures">
  <bpmn:process id="p" isExecutable="true">
    <bpmn:startEvent id="start">
      <bpmn:outgoing>f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="xs" default="f_def">
      <bpmn:incoming>f1</bpmn:incoming>
      <bpmn:outgoing>f_fn</bpmn:outgoing>
      <bpmn:outgoing>f_arith</bpmn:outgoing>
      <bpmn:outgoing>f_range</bpmn:outgoing>
      <bpmn:outgoing>f_def</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="ta" name="A">
      <bpmn:incoming>f_fn</bpmn:incoming>
      <bpmn:outgoing>f2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="tb" name="B">
      <bpmn:incoming>f_arith</bpmn:incoming>
      <bpmn:outgoing>f3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="tc" name="C">
      <bpmn:incoming>f_range</bpmn:incoming>
      <bpmn:outgoing>f4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="td" name="D">
      <bpmn:incoming>f_def</bpmn:incoming>
      <bpmn:outgoing>f5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="e_a">
      <bpmn:incoming>f2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="e_b">
      <bpmn:incoming>f3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="e_c">
      <bpmn:incoming>f4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="e_d">
      <bpmn:incoming>f5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="xs" />
    <bpmn:sequenceFlow id="f_fn" sourceRef="xs" targetRef="ta">
      <bpmn:conditionExpression>sum(items) &gt; 3</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f_arith" sourceRef="xs" targetRef="tb">
      <bpmn:conditionExpression>amount + fee &gt; 100</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f_range" sourceRef="xs" targetRef="tc">
      <bpmn:conditionExpression>amount in [1..100]</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f_def" sourceRef="xs" targetRef="td" />
    <bpmn:sequenceFlow id="f2" sourceRef="ta" targetRef="e_a" />
    <bpmn:sequenceFlow id="f3" sourceRef="tb" targetRef="e_b" />
    <bpmn:sequenceFlow id="f4" sourceRef="tc" targetRef="e_c" />
    <bpmn:sequenceFlow id="f5" sourceRef="td" targetRef="e_d" />
  </bpmn:process>
