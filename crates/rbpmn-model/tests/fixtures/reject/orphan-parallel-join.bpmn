<?xml version="1.0" encoding="UTF-8"?>
<!-- expect-diagnostics:
  error balanced-gateways @ pj
-->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  id="defs" targetNamespace="https://rbpmn.dev/fixtures">
  <!-- A parallel join fed by exclusive arms: only one token ever arrives,
       so the join deadlocks. There is no matching parallel split. -->
  <bpmn:process id="p" isExecutable="true">
    <bpmn:startEvent id="start"/>
    <bpmn:exclusiveGateway id="xs" default="f_b"/>
    <bpmn:userTask id="ta" name="A"/>
    <bpmn:userTask id="tb" name="B"/>
    <bpmn:parallelGateway id="pj"/>
    <bpmn:endEvent id="end"/>
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="xs"/>
    <bpmn:sequenceFlow id="f_a" sourceRef="xs" targetRef="ta">
      <bpmn:conditionExpression>/a == true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f_b" sourceRef="xs" targetRef="tb"/>
    <bpmn:sequenceFlow id="f2" sourceRef="ta" targetRef="pj"/>
    <bpmn:sequenceFlow id="f3" sourceRef="tb" targetRef="pj"/>
    <bpmn:sequenceFlow id="f4" sourceRef="pj" targetRef="end"/>
  </bpmn:process>
</bpmn:definitions>
