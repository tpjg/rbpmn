<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="defs" targetNamespace="https://rbpmn.dev/fixtures">
  <bpmn:process id="p" isExecutable="true">
    <bpmn:startEvent id="start">
      <bpmn:outgoing>f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:parallelGateway id="ps">
      <bpmn:incoming>f1</bpmn:incoming>
      <bpmn:outgoing>f2</bpmn:outgoing>
      <bpmn:outgoing>f4</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="ta" name="A">
      <bpmn:incoming>f2</bpmn:incoming>
      <bpmn:outgoing>f3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="xs" default="f_d">
      <bpmn:incoming>f4</bpmn:incoming>
      <bpmn:outgoing>f_c</bpmn:outgoing>
      <bpmn:outgoing>f_d</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="td" name="Dead branch">
      <bpmn:incoming>f_d</bpmn:incoming>
      <bpmn:outgoing>f5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="e_leak">
      <bpmn:incoming>f5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:parallelGateway id="pj">
      <bpmn:incoming>f3</bpmn:incoming>
      <bpmn:incoming>f_c</bpmn:incoming>
      <bpmn:outgoing>f6</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:endEvent id="e_ok">
      <bpmn:incoming>f6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="ps" />
    <bpmn:sequenceFlow id="f2" sourceRef="ps" targetRef="ta" />
    <bpmn:sequenceFlow id="f3" sourceRef="ta" targetRef="pj" />
    <bpmn:sequenceFlow id="f4" sourceRef="ps" targetRef="xs" />
    <bpmn:sequenceFlow id="f_c" sourceRef="xs" targetRef="pj">
      <bpmn:conditionExpression>skip = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f_d" sourceRef="xs" targetRef="td" />
    <bpmn:sequenceFlow id="f5" sourceRef="td" targetRef="e_leak" />
    <bpmn:sequenceFlow id="f6" sourceRef="pj" targetRef="e_ok" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_p">
