<?xml version="1.0" encoding="UTF-8"?>
<!-- expect-diagnostics:
  error no-call-activity @ ca
-->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  id="defs" targetNamespace="https://rbpmn.dev/fixtures">
  <bpmn:process id="p" isExecutable="true">
    <bpmn:startEvent id="start"/>
    <bpmn:callActivity id="ca" name="Run child process" calledElement="child"/>
    <bpmn:endEvent id="end"/>
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="ca"/>
    <bpmn:sequenceFlow id="f2" sourceRef="ca" targetRef="end"/>
  </bpmn:process>
</bpmn:definitions>
