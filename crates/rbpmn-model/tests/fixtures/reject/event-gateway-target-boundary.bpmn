<?xml version="1.0" encoding="UTF-8"?>
<!-- expect-diagnostics:
  error event-gateway-structure @ bt
-->
<!-- A boundary timer on an event-gateway alternative would never arm (the
     gateway holds the token; the target is never entered) — rejected
     instead of silently not existing at runtime. The timeout belongs as a
     timer alternative of the gateway itself. -->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="defs" targetNamespace="https://rbpmn.dev/fixtures">
  <bpmn:message id="m_a" name="AnswerA" />
  <bpmn:message id="m_b" name="AnswerB" />
  <bpmn:process id="p" isExecutable="true">
    <bpmn:startEvent id="start">
      <bpmn:outgoing>f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:eventBasedGateway id="ebg">
      <bpmn:incoming>f1</bpmn:incoming>
      <bpmn:outgoing>f2</bpmn:outgoing>
      <bpmn:outgoing>f3</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:receiveTask id="rt" name="Await A" messageRef="m_a">
      <bpmn:incoming>f2</bpmn:incoming>
      <bpmn:outgoing>f4</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:boundaryEvent id="bt" attachedToRef="rt">
      <bpmn:outgoing>f6</bpmn:outgoing>
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration>PT1H</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:intermediateCatchEvent id="c_b">
      <bpmn:incoming>f3</bpmn:incoming>
      <bpmn:outgoing>f5</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="m_b" />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="e_a">
      <bpmn:incoming>f4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="e_b">
      <bpmn:incoming>f5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="e_t">
      <bpmn:incoming>f6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="ebg" />
    <bpmn:sequenceFlow id="f2" sourceRef="ebg" targetRef="rt" />
    <bpmn:sequenceFlow id="f3" sourceRef="ebg" targetRef="c_b" />
    <bpmn:sequenceFlow id="f4" sourceRef="rt" targetRef="e_a" />
    <bpmn:sequenceFlow id="f5" sourceRef="c_b" targetRef="e_b" />
    <bpmn:sequenceFlow id="f6" sourceRef="bt" targetRef="e_t" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_p">
    <bpmndi:BPMNPlane id="BPMNPlane_p" bpmnElement="p">
      <bpmndi:BPMNShape id="start_di" bpmnElement="start">
        <dc:Bounds x="57" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ebg_di" bpmnElement="ebg">
        <dc:Bounds x="200" y="45" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="rt_di" bpmnElement="rt">
        <dc:Bounds x="325" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="bt_di" bpmnElement="bt">
        <dc:Bounds x="357" y="92" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="e_a_di" bpmnElement="e_a">
        <dc:Bounds x="507" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="e_t_di" bpmnElement="e_t">
        <dc:Bounds x="507" y="192" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="c_b_di" bpmnElement="c_b">
        <dc:Bounds x="357" y="332" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="e_b_di" bpmnElement="e_b">
        <dc:Bounds x="507" y="332" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="f1_di" bpmnElement="f1">
