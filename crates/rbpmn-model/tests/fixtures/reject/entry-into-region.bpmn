<?xml version="1.0" encoding="UTF-8"?>
<!-- expect-diagnostics:
  error balanced-gateways @ f_in
-->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  id="defs" targetNamespace="https://rbpmn.dev/fixtures">
  <!-- A token sneaking into a parallel branch from outside the block breaks
       local token counting at the join. -->
  <bpmn:process id="p" isExecutable="true">
    <bpmn:startEvent id="start"/>
    <bpmn:exclusiveGateway id="x0" default="f_norm"/>
    <bpmn:parallelGateway id="ps"/>
    <bpmn:userTask id="ta" name="A"/>
    <bpmn:userTask id="tb" name="B"/>
    <bpmn:parallelGateway id="pj"/>
    <bpmn:endEvent id="end"/>
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="x0"/>
    <bpmn:sequenceFlow id="f_in" sourceRef="x0" targetRef="ta">
      <bpmn:conditionExpression>/rush == true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f_norm" sourceRef="x0" targetRef="ps"/>
    <bpmn:sequenceFlow id="f2" sourceRef="ps" targetRef="ta"/>
    <bpmn:sequenceFlow id="f3" sourceRef="ps" targetRef="tb"/>
    <bpmn:sequenceFlow id="f4" sourceRef="ta" targetRef="pj"/>
    <bpmn:sequenceFlow id="f5" sourceRef="tb" targetRef="pj"/>
    <bpmn:sequenceFlow id="f6" sourceRef="pj" targetRef="end"/>
  </bpmn:process>
</bpmn:definitions>
