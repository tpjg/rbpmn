<?xml version="1.0" encoding="UTF-8"?>
<!-- expect-diagnostics:
  error timer-iso8601 @ c
-->
<!-- The one timer text that has nowhere left to go. Parse order is the
     discriminator — a valid ISO-8601 literal first, otherwise a FEEL
     qualified name naming the deadline in the variable document — and
     "5 minutes" is neither: not a duration, and not a qualified name either
     (a space, and a leading digit). So this errors where accept/23 warns.

     Note what is NOT consulted: xsi:type="bpmn:tFormalExpression". An
     earlier version made that marker the discriminator, on the theory that
     it signals the author meant an expression. bpmn-moddle emits it for any
     expression object, so every bpmn-js modeler stamps it on ordinary
     literal durations, and `P3D` became a variable lookup named `P3D`.

     The grammars really do overlap, and that cost is paid in
     accept/24-timer-typo-reads-as-variable.bpmn: `P30X` is a mistyped
     duration *and* a valid qualified name, so it warns rather than
     erroring, with the ISO-8601 complaint carried in the warning text. -->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="defs" targetNamespace="https://rbpmn.dev/fixtures">
  <bpmn:process id="p" isExecutable="true">
    <bpmn:startEvent id="start">
      <bpmn:outgoing>f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:intermediateCatchEvent id="c" name="Wait">
      <bpmn:incoming>f1</bpmn:incoming>
      <bpmn:outgoing>f2</bpmn:outgoing>
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration>5 minutes</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="end">
      <bpmn:incoming>f2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="c" />
    <bpmn:sequenceFlow id="f2" sourceRef="c" targetRef="end" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_p">
    <bpmndi:BPMNPlane id="BPMNPlane_p" bpmnElement="p">
      <bpmndi:BPMNShape id="start_di" bpmnElement="start">
        <dc:Bounds x="57" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="c_di" bpmnElement="c">
        <dc:Bounds x="207" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_di" bpmnElement="end">
        <dc:Bounds x="357" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="f1_di" bpmnElement="f1">
        <di:waypoint x="93" y="70" />
        <di:waypoint x="207" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f2_di" bpmnElement="f2">
        <di:waypoint x="243" y="70" />
        <di:waypoint x="357" y="70" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
