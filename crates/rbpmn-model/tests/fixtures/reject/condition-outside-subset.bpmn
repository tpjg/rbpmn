<?xml version="1.0" encoding="UTF-8"?>
<!-- expect-diagnostics:
  error conditions-feel-subset @ f_hi
-->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  id="defs" targetNamespace="https://rbpmn.dev/fixtures">
  <bpmn:process id="p" isExecutable="true">
    <bpmn:startEvent id="start"/>
    <bpmn:exclusiveGateway id="xs" default="f_lo"/>
    <bpmn:userTask id="ta" name="A"/>
    <bpmn:userTask id="tb" name="B"/>
    <bpmn:endEvent id="e_a"/>
    <bpmn:endEvent id="e_b"/>
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="xs"/>
    <bpmn:sequenceFlow id="f_hi" sourceRef="xs" targetRef="ta">
      <bpmn:conditionExpression>amount &gt; 100 &amp;&amp; vip</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f_lo" sourceRef="xs" targetRef="tb"/>
    <bpmn:sequenceFlow id="f2" sourceRef="ta" targetRef="e_a"/>
    <bpmn:sequenceFlow id="f3" sourceRef="tb" targetRef="e_b"/>
  </bpmn:process>
</bpmn:definitions>
