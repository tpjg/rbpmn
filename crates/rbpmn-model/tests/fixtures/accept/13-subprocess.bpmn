        <bpmn:outgoing>fi2</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="e2">
        <bpmn:incoming>fi2</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="fi1" sourceRef="s2" targetRef="ti" />
      <bpmn:sequenceFlow id="fi2" sourceRef="ti" targetRef="e2" />
    </bpmn:subProcess>
    <bpmn:boundaryEvent id="bt" attachedToRef="sp">
      <bpmn:outgoing>f3</bpmn:outgoing>
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration>P2D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:userTask id="t_late" name="Chase warehouse">
      <bpmn:incoming>f3</bpmn:incoming>
      <bpmn:outgoing>f4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="end">
