<?xml version="1.0" encoding="UTF-8"?>
<!-- expect-diagnostics:
  warn timer-expression @ wait
-->
<!-- Two branches, one of which can freeze the instance while the other is
     parked on a decision. That combination is what proved `WaitKind::Decision`
     is not like the other wait states: the caller answers it before the
     transaction ends, so a freeze that left one behind made the engine answer
     a decision on a Failed instance and roll back the transaction that was
     supposed to *record* the freeze. -->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="defs" targetNamespace="https://rbpmn.dev/fixtures" expressionLanguage="https://www.omg.org/spec/DMN/20191111/FEEL/">
  <bpmn:process id="p" isExecutable="true">
    <bpmn:startEvent id="start">
      <bpmn:outgoing>f0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:parallelGateway id="split">
      <bpmn:incoming>f0</bpmn:incoming>
      <bpmn:outgoing>fa</bpmn:outgoing>
      <bpmn:outgoing>fb</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:businessRuleTask id="decide" name="Price it">
      <bpmn:incoming>fa</bpmn:incoming>
      <bpmn:outgoing>fa2</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:intermediateCatchEvent id="wait" name="Hold">
      <bpmn:incoming>fb</bpmn:incoming>
      <bpmn:outgoing>fb2</bpmn:outgoing>
      <bpmn:timerEventDefinition id="ted">
        <bpmn:timeDuration>order.slaDuration</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:parallelGateway id="join">
      <bpmn:incoming>fa2</bpmn:incoming>
      <bpmn:incoming>fb2</bpmn:incoming>
      <bpmn:outgoing>f3</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:endEvent id="end">
      <bpmn:incoming>f3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f0" sourceRef="start" targetRef="split" />
    <bpmn:sequenceFlow id="fa" sourceRef="split" targetRef="decide" />
    <bpmn:sequenceFlow id="fb" sourceRef="split" targetRef="wait" />
    <bpmn:sequenceFlow id="fa2" sourceRef="decide" targetRef="join" />
    <bpmn:sequenceFlow id="fb2" sourceRef="wait" targetRef="join" />
    <bpmn:sequenceFlow id="f3" sourceRef="join" targetRef="end" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_p">
    <bpmndi:BPMNPlane id="BPMNPlane_p" bpmnElement="p">
      <bpmndi:BPMNShape id="start_di" bpmnElement="start">
        <dc:Bounds x="57" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="split_di" bpmnElement="split">
        <dc:Bounds x="200" y="45" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="decide_di" bpmnElement="decide">
        <dc:Bounds x="325" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="join_di" bpmnElement="join">
        <dc:Bounds x="500" y="45" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_di" bpmnElement="end">
        <dc:Bounds x="657" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="wait_di" bpmnElement="wait">
        <dc:Bounds x="357" y="192" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="f0_di" bpmnElement="f0">
        <di:waypoint x="93" y="70" />
        <di:waypoint x="200" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="fa_di" bpmnElement="fa">
        <di:waypoint x="250" y="70" />
        <di:waypoint x="325" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="fb_di" bpmnElement="fb">
        <di:waypoint x="225" y="95" />
        <di:waypoint x="225" y="210" />
        <di:waypoint x="357" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="fa2_di" bpmnElement="fa2">
        <di:waypoint x="425" y="70" />
        <di:waypoint x="500" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f3_di" bpmnElement="f3">
        <di:waypoint x="550" y="70" />
        <di:waypoint x="657" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="fb2_di" bpmnElement="fb2">
        <di:waypoint x="393" y="210" />
        <di:waypoint x="525" y="210" />
        <di:waypoint x="525" y="95" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
