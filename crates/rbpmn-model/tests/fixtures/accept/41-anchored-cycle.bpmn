<?xml version="1.0" encoding="UTF-8"?>
<!-- expect-diagnostics:
-->
<!-- "Nudge on the next two Mondays at midnight, Amsterdam time." The anchor
     fixes the *phase*, not a set of instants: the first due is the first
     occurrence at or after the arm, and R2 counts fires from there —
     occurrences already in the past are never replayed. Periods are
     fixed-length, so this drifts an hour across a daylight-saving change;
     said out loud rather than papered over (design §2.5). -->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="defs" targetNamespace="https://rbpmn.dev/fixtures">
  <bpmn:process id="p" isExecutable="true">
    <bpmn:startEvent id="start">
      <bpmn:outgoing>f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="await_signature" name="Await signature">
      <bpmn:incoming>f1</bpmn:incoming>
      <bpmn:outgoing>f2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:boundaryEvent id="weekly_nudge" name="Weekly nudge" cancelActivity="false" attachedToRef="await_signature">
      <bpmn:outgoing>f3</bpmn:outgoing>
      <bpmn:timerEventDefinition>
        <bpmn:timeCycle>R2/2026-08-31T00:00:00+02:00/P7D</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:serviceTask id="nudge" name="Send a nudge">
      <bpmn:incoming>f3</bpmn:incoming>
      <bpmn:outgoing>f4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="signed" name="Signed">
      <bpmn:incoming>f2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="nudged" name="Nudged">
      <bpmn:incoming>f4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="await_signature" />
    <bpmn:sequenceFlow id="f2" sourceRef="await_signature" targetRef="signed" />
    <bpmn:sequenceFlow id="f3" sourceRef="weekly_nudge" targetRef="nudge" />
    <bpmn:sequenceFlow id="f4" sourceRef="nudge" targetRef="nudged" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_p">
    <bpmndi:BPMNPlane id="BPMNPlane_p" bpmnElement="p">
      <bpmndi:BPMNShape id="start_di" bpmnElement="start">
        <dc:Bounds x="57" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="await_signature_di" bpmnElement="await_signature">
        <dc:Bounds x="175" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="weekly_nudge_di" bpmnElement="weekly_nudge">
        <dc:Bounds x="207" y="92" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="signed_di" bpmnElement="signed">
        <dc:Bounds x="357" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="nudge_di" bpmnElement="nudge">
        <dc:Bounds x="325" y="170" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="nudged_di" bpmnElement="nudged">
        <dc:Bounds x="507" y="192" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="f1_di" bpmnElement="f1">
        <di:waypoint x="93" y="70" />
        <di:waypoint x="175" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f2_di" bpmnElement="f2">
        <di:waypoint x="275" y="70" />
        <di:waypoint x="357" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f3_di" bpmnElement="f3">
        <di:waypoint x="225" y="128" />
        <di:waypoint x="225" y="210" />
        <di:waypoint x="325" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f4_di" bpmnElement="f4">
        <di:waypoint x="425" y="210" />
        <di:waypoint x="507" y="210" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
