<?xml version="1.0" encoding="UTF-8"?>
<!-- expect-diagnostics:
-->
<!-- A non-interrupting boundary on a subprocess: the escalation runs beside
     the work rather than instead of it. The sibling token is spawned in the
     *parent* scope — the boundary's outgoing flow lives there, beside the
     parked subprocess token — so the subprocess keeps running, and the
     instance stays active until both the subprocess and the escalation have
     finished. -->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="defs" targetNamespace="https://rbpmn.dev/fixtures">
  <bpmn:process id="shipment" isExecutable="true">
    <bpmn:startEvent id="start">
      <bpmn:outgoing>f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:subProcess id="sp" name="Fulfil">
      <bpmn:incoming>f1</bpmn:incoming>
      <bpmn:outgoing>f2</bpmn:outgoing>
      <bpmn:startEvent id="s2">
        <bpmn:outgoing>fi1</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="pack" name="Pack the order">
        <bpmn:incoming>fi1</bpmn:incoming>
        <bpmn:outgoing>fi2</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="packed">
        <bpmn:incoming>fi2</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="fi1" sourceRef="s2" targetRef="pack" />
      <bpmn:sequenceFlow id="fi2" sourceRef="pack" targetRef="packed" />
    </bpmn:subProcess>
    <bpmn:boundaryEvent id="taking_long" name="Taking long" cancelActivity="false" attachedToRef="sp">
      <bpmn:outgoing>f3</bpmn:outgoing>
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration>PT4H</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:serviceTask id="warn_customer" name="Warn the customer">
      <bpmn:incoming>f3</bpmn:incoming>
      <bpmn:outgoing>f4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="shipped" name="Shipped">
      <bpmn:incoming>f2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="warned" name="Customer warned">
      <bpmn:incoming>f4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="sp" />
    <bpmn:sequenceFlow id="f2" sourceRef="sp" targetRef="shipped" />
    <bpmn:sequenceFlow id="f3" sourceRef="taking_long" targetRef="warn_customer" />
    <bpmn:sequenceFlow id="f4" sourceRef="warn_customer" targetRef="warned" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_shipment">
    <bpmndi:BPMNPlane id="BPMNPlane_shipment" bpmnElement="shipment">
      <bpmndi:BPMNShape id="start_di" bpmnElement="start">
        <dc:Bounds x="57" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sp_di" bpmnElement="sp">
        <dc:Bounds x="175" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="taking_long_di" bpmnElement="taking_long">
        <dc:Bounds x="207" y="92" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shipped_di" bpmnElement="shipped">
        <dc:Bounds x="357" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="warn_customer_di" bpmnElement="warn_customer">
        <dc:Bounds x="325" y="170" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="warned_di" bpmnElement="warned">
        <dc:Bounds x="507" y="192" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="f1_di" bpmnElement="f1">
        <di:waypoint x="93" y="70" />
        <di:waypoint x="175" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f2_di" bpmnElement="f2">
        <di:waypoint x="275" y="70" />
        <di:waypoint x="357" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f3_di" bpmnElement="f3">
        <di:waypoint x="225" y="128" />
        <di:waypoint x="225" y="210" />
        <di:waypoint x="325" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f4_di" bpmnElement="f4">
        <di:waypoint x="425" y="210" />
        <di:waypoint x="507" y="210" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
  <bpmndi:BPMNDiagram id="BPMNDiagram_sp">
    <bpmndi:BPMNPlane id="BPMNPlane_sp" bpmnElement="sp">
      <bpmndi:BPMNShape id="s2_di" bpmnElement="s2">
        <dc:Bounds x="57" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="pack_di" bpmnElement="pack">
        <dc:Bounds x="175" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="packed_di" bpmnElement="packed">
        <dc:Bounds x="357" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="fi1_di" bpmnElement="fi1">
        <di:waypoint x="93" y="70" />
        <di:waypoint x="175" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="fi2_di" bpmnElement="fi2">
        <di:waypoint x="275" y="70" />
        <di:waypoint x="357" y="70" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
