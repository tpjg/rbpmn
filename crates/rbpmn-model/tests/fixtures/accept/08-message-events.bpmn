<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="defs" targetNamespace="https://rbpmn.dev/fixtures">
  <bpmn:message id="m_start" name="OrderPlaced" />
  <bpmn:message id="m_notify" name="WarehouseNotified" />
  <bpmn:message id="m_reply" name="WarehouseAck" />
  <bpmn:message id="m_done" name="OrderShipped" />
  <bpmn:process id="p" isExecutable="true">
    <bpmn:startEvent id="s_msg">
      <bpmn:outgoing>f1</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="m_start" />
    </bpmn:startEvent>
    <bpmn:intermediateThrowEvent id="th">
      <bpmn:incoming>f1</bpmn:incoming>
      <bpmn:outgoing>f2</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="m_notify" />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateCatchEvent id="c">
      <bpmn:incoming>f2</bpmn:incoming>
      <bpmn:outgoing>f3</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="m_reply" />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="e_msg">
      <bpmn:incoming>f3</bpmn:incoming>
      <bpmn:messageEventDefinition messageRef="m_done" />
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f1" sourceRef="s_msg" targetRef="th" />
    <bpmn:sequenceFlow id="f2" sourceRef="th" targetRef="c" />
    <bpmn:sequenceFlow id="f3" sourceRef="c" targetRef="e_msg" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_p">
    <bpmndi:BPMNPlane id="BPMNPlane_p" bpmnElement="p">
