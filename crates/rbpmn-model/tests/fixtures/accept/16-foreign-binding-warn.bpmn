<?xml version="1.0" encoding="UTF-8"?>
<!-- expect-diagnostics:
  warn no-foreign-implementation @ st
-->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
                  id="defs" targetNamespace="https://rbpmn.dev/fixtures">
  <!-- Vendor attributes are ignored, never executed: the model still deploys
       (topics are bound at registration time), but the modeler is warned that
       the camunda binding is dead weight. -->
  <bpmn:process id="p" isExecutable="true">
    <bpmn:startEvent id="start"/>
    <bpmn:serviceTask id="st" name="Charge card" camunda:topic="payments"/>
    <bpmn:endEvent id="end"/>
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="st"/>
    <bpmn:sequenceFlow id="f2" sourceRef="st" targetRef="end"/>
  </bpmn:process>
</bpmn:definitions>
