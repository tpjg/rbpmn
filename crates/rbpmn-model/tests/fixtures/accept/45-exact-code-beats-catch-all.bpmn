<?xml version="1.0" encoding="UTF-8"?>
<!-- expect-diagnostics:
-->
<!-- Most specific wins. A coded boundary and a catch-all on one activity: a
     failure carrying CARD_DECLINED takes the coded path, and anything else —
     another code, or no code at all — takes the catch-all. The catch-all is
     declared first on purpose: declaration order is not what decides it, and
     a matcher that stopped at the first boundary it found would get this
     wrong. -->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="defs" targetNamespace="https://rbpmn.dev/fixtures">
  <bpmn:error id="err_declined" name="CardDeclined" errorCode="CARD_DECLINED" />
  <bpmn:process id="p" isExecutable="true">
    <bpmn:startEvent id="start">
      <bpmn:outgoing>f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="charge" name="Charge the card">
      <bpmn:incoming>f1</bpmn:incoming>
      <bpmn:outgoing>f2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="be_any" name="Anything else" attachedToRef="charge">
      <bpmn:outgoing>f3</bpmn:outgoing>
      <bpmn:errorEventDefinition />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="be_declined" name="Declined" attachedToRef="charge">
      <bpmn:outgoing>f4</bpmn:outgoing>
      <bpmn:errorEventDefinition errorRef="err_declined" />
    </bpmn:boundaryEvent>
    <bpmn:endEvent id="charged">
      <bpmn:incoming>f2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="failed">
      <bpmn:incoming>f3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="declined">
      <bpmn:incoming>f4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="charge" />
    <bpmn:sequenceFlow id="f2" sourceRef="charge" targetRef="charged" />
    <bpmn:sequenceFlow id="f3" sourceRef="be_any" targetRef="failed" />
    <bpmn:sequenceFlow id="f4" sourceRef="be_declined" targetRef="declined" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_p">
    <bpmndi:BPMNPlane id="BPMNPlane_p" bpmnElement="p">
      <bpmndi:BPMNShape id="start_di" bpmnElement="start">
        <dc:Bounds x="57" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="charge_di" bpmnElement="charge">
        <dc:Bounds x="175" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="be_any_di" bpmnElement="be_any">
        <dc:Bounds x="190.33333333333334" y="92" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="be_declined_di" bpmnElement="be_declined">
        <dc:Bounds x="223.66666666666669" y="92" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="charged_di" bpmnElement="charged">
        <dc:Bounds x="357" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="declined_di" bpmnElement="declined">
        <dc:Bounds x="357" y="192" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="failed_di" bpmnElement="failed">
        <dc:Bounds x="357" y="332" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="f1_di" bpmnElement="f1">
        <di:waypoint x="93" y="70" />
        <di:waypoint x="175" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f2_di" bpmnElement="f2">
        <di:waypoint x="275" y="70" />
        <di:waypoint x="357" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f3_di" bpmnElement="f3">
        <di:waypoint x="208.33333333333334" y="128" />
        <di:waypoint x="208.33333333333334" y="350" />
        <di:waypoint x="357" y="350" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f4_di" bpmnElement="f4">
        <di:waypoint x="241.66666666666669" y="128" />
        <di:waypoint x="241.66666666666669" y="210" />
        <di:waypoint x="357" y="210" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
