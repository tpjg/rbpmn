<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="defs" targetNamespace="https://rbpmn.dev/fixtures">
  <bpmn:process id="p" isExecutable="true">
    <bpmn:startEvent id="start">
      <bpmn:outgoing>f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="xj_loop">
      <bpmn:incoming>f1</bpmn:incoming>
      <bpmn:incoming>f_again</bpmn:incoming>
      <bpmn:outgoing>f2</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:parallelGateway id="ps">
      <bpmn:incoming>f2</bpmn:incoming>
      <bpmn:outgoing>f3</bpmn:outgoing>
      <bpmn:outgoing>f4</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="ta" name="A">
      <bpmn:incoming>f3</bpmn:incoming>
      <bpmn:outgoing>f5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="tb" name="B">
      <bpmn:incoming>f4</bpmn:incoming>
      <bpmn:outgoing>f6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:parallelGateway id="pj">
      <bpmn:incoming>f5</bpmn:incoming>
      <bpmn:incoming>f6</bpmn:incoming>
      <bpmn:outgoing>f7</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:exclusiveGateway id="xs_loop" default="f_done">
      <bpmn:incoming>f7</bpmn:incoming>
      <bpmn:outgoing>f_again</bpmn:outgoing>
      <bpmn:outgoing>f_done</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="end">
      <bpmn:incoming>f_done</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="xj_loop" />
    <bpmn:sequenceFlow id="f2" sourceRef="xj_loop" targetRef="ps" />
    <bpmn:sequenceFlow id="f3" sourceRef="ps" targetRef="ta" />
    <bpmn:sequenceFlow id="f4" sourceRef="ps" targetRef="tb" />
    <bpmn:sequenceFlow id="f5" sourceRef="ta" targetRef="pj" />
    <bpmn:sequenceFlow id="f6" sourceRef="tb" targetRef="pj" />
    <bpmn:sequenceFlow id="f7" sourceRef="pj" targetRef="xs_loop" />
    <bpmn:sequenceFlow id="f_again" sourceRef="xs_loop" targetRef="xj_loop">
      <bpmn:conditionExpression>again = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f_done" sourceRef="xs_loop" targetRef="end" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_p">
    <bpmndi:BPMNPlane id="BPMNPlane_p" bpmnElement="p">
