      <bpmn:incoming>f7</bpmn:incoming>
      <bpmn:outgoing>f8</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:endEvent id="end">
      <bpmn:incoming>f8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="ps" />
    <bpmn:sequenceFlow id="f2" sourceRef="ps" targetRef="xs" />
    <bpmn:sequenceFlow id="f_f" sourceRef="xs" targetRef="tf">
      <bpmn:conditionExpression>fast = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f_s" sourceRef="xs" targetRef="ts" />
    <bpmn:sequenceFlow id="f3" sourceRef="tf" targetRef="xj" />
    <bpmn:sequenceFlow id="f4" sourceRef="ts" targetRef="xj" />
    <bpmn:sequenceFlow id="f5" sourceRef="xj" targetRef="pj" />
    <bpmn:sequenceFlow id="f6" sourceRef="ps" targetRef="tb" />
    <bpmn:sequenceFlow id="f7" sourceRef="tb" targetRef="pj" />
    <bpmn:sequenceFlow id="f8" sourceRef="pj" targetRef="end" />
  </bpmn:process>
