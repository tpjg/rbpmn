  "scope": {
    "summary": "An instance waiting on a correlated message, delivered by the harness.",
    "measures": [
      "arming a subscription and the indexed (message_name, correlation_key) lookup correlate() performs",
      "delivery as a step: the message's merge patch and the token's advance commit in one transaction",
      "the correlator's retry loop — the catch is not the first element, so a key whose subscription is not armed yet is the ordinary case, and the retries are counted in the result file"
    ],
    "excludes": [
      "message transport: correlate() is called in-process, so there is no broker, no HTTP and no queue in these numbers",
      "the no-match and ambiguous-match paths (404 and 409), which are error handling rather than throughput",
      "history levels: every event is written"
    ],
