<?xml version="1.0" encoding="UTF-8"?>
<!-- The same long-running shape, waiting on a correlated message instead of
     a timer: register, then wait for the outside world, then do the work.

     This is the population that matters for `correlate`. A million open
     subscriptions sit in rbpmn_subscription indexed on
     (message_name, correlation_key), and the question the scenario answers
     is whether delivery stays an indexed probe at that size — the engine's
     "exactly one open subscription of an active instance" contract has to
     find its one match among a million. -->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="defs" targetNamespace="https://rbpmn.dev/benchmarks">
  <bpmn:message id="m_callback" name="ContractCallback" />
  <bpmn:process id="population-message" isExecutable="true">
    <bpmn:startEvent id="Start">
      <bpmn:outgoing>f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="RegisterContract" name="Register contract">
      <bpmn:incoming>f1</bpmn:incoming>
      <bpmn:outgoing>f2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateCatchEvent id="AwaitCallback" name="Await callback">
      <bpmn:incoming>f2</bpmn:incoming>
      <bpmn:outgoing>f3</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="m_callback" />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="AssessRenewal" name="Assess renewal">
      <bpmn:incoming>f3</bpmn:incoming>
      <bpmn:outgoing>f4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="PriceRenewal" name="Price renewal">
      <bpmn:incoming>f4</bpmn:incoming>
      <bpmn:outgoing>f5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="NotifyCustomer" name="Notify customer">
      <bpmn:incoming>f5</bpmn:incoming>
      <bpmn:outgoing>f6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="CloseContract" name="Close contract">
      <bpmn:incoming>f6</bpmn:incoming>
      <bpmn:outgoing>f7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End">
      <bpmn:incoming>f7</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f1" sourceRef="Start" targetRef="RegisterContract" />
    <bpmn:sequenceFlow id="f2" sourceRef="RegisterContract" targetRef="AwaitCallback" />
    <bpmn:sequenceFlow id="f3" sourceRef="AwaitCallback" targetRef="AssessRenewal" />
    <bpmn:sequenceFlow id="f4" sourceRef="AssessRenewal" targetRef="PriceRenewal" />
    <bpmn:sequenceFlow id="f5" sourceRef="PriceRenewal" targetRef="NotifyCustomer" />
    <bpmn:sequenceFlow id="f6" sourceRef="NotifyCustomer" targetRef="CloseContract" />
    <bpmn:sequenceFlow id="f7" sourceRef="CloseContract" targetRef="End" />
  </bpmn:process>
</bpmn:definitions>
